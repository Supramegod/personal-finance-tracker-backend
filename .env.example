# ============================================
# Personal Finance Tracker — Backend (Go)
# Environment Variables Template
# ============================================
# Copy file ini ke .env dan isi nilai aktual
# cp .env.example .env
#
# WAJIB diisi (aplikasi menolak start kalau kosong):
#   DATABASE_URL, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD
# Sisanya punya default yang aman untuk development.
# ============================================

# ---- Database ---- [WAJIB]
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname?sslmode=disable
# Nilai di bawah cocok dengan docker-compose.yml untuk development lokal.
# Untuk staging/produksi WAJIB diganti dan pakai sslmode=require.
DATABASE_URL=postgresql://finance:finance123@localhost:5432/finance_tracker?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ---- Authentication ---- [WAJIB]
# JWT Secret: string acak, minimum 32 karakter (divalidasi saat start).
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
# Durasi expiry hanya boleh menggunakan unit durasi Go (h/m/s), mis. "15m"
# atau "168h" — unit seperti "d" (hari) TIDAK didukung oleh time.ParseDuration
# dan akan membuat nilai ini diabaikan secara diam-diam (fallback ke default).
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ---- Admin Seed ---- [WAJIB]
# User admin pertama, dibuat sekali saat start jika email-nya belum terdaftar.
# Tidak ada nilai default di kode — default yang lemah akan terpakai diam-diam
# kalau lupa diset saat deploy, dan isinya terbaca publik dari source code.
# Generate password: openssl rand -base64 24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- Server ----
# Port aplikasi Go
PORT=8080
# Environment: development | staging | production
APP_ENV=development

# ---- CORS ----
# Origin yang diizinkan (pisah dengan koma untuk multiple)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Rate Limiting ----
# Maksimal request per menit per IP
RATE_LIMIT_PER_MINUTE=60

# ---- Logging ----
# Level: debug | info | warn | error
LOG_LEVEL=debug

# ---- AI Financial Insights (opsional) ----
# Data hanya diproses untuk kelompok yang memberi consent.
AI_INSIGHTS_ENABLED=false
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
AI_PROMPT_VERSION=v1
AI_TIMEOUT=30s
